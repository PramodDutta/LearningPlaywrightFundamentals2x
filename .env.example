# Copy to .env and fill in your own VWO credentials
VWO_USER=
VWO_PASS=

# Module 19 - Data Driven Testing from MySQL (300_DDT_MySQL.spec.ts)
# Leave MYSQL_HOST empty to skip that suite.
# Seed first: mysql -u root -p < tests/19_Data_Driven_Testing/test-data/login-data.sql
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=playwright_ddt
